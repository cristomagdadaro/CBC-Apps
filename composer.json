{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "guzzlehttp/guzzle": "^7.2",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^13.0",
        "laravel/jetstream": "^5.0",
        "laravel/reverb": "^1.9",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "milon/barcode": "^13.0",
        "nunomaduro/collision": "^8.6",
        "nunomaduro/termwind": "^2.0",
        "pusher/pusher-php-server": "^7.2",
        "spatie/laravel-google-calendar": "^3.8",
        "tightenco/ziggy": "^2.5"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.14",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.4.4",
        "pestphp/pest-plugin-stressless": "*",
        "phpunit/phpunit": "^11.0.1",
        "smeghead/php-class-diagram": "^1.6",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": {
                "PKSA-m5cs-t1y6-qpcs": "Laravel 11 EOL — tracked for Laravel 12 upgrade",
                "PKSA-3r5d-mb8f-1qw9": "Laravel 11 EOL — tracked for Laravel 12 upgrade",
                "PKSA-mdq4-51ck-6kdq": "Laravel 11 EOL — tracked for Laravel 12 upgrade",
                "PKSA-8qx3-n5y5-vvnd": "Laravel 11 EOL — tracked for Laravel 12 upgrade",
                "PKSA-q46n-4fdk-zjr4": "Laravel 11 EOL — tracked for Laravel 12 upgrade",
                "PKSA-qzrn-rnz3-85w1": "Laravel 11 EOL — tracked for Laravel 12 upgrade",
                "PKSA-w7xr-vk7n-rstm": "Laravel 11 EOL — tracked for Laravel 12 upgrade",
                "PKSA-njrm-6dtg-m2pc": "Laravel 11 EOL — tracked for Laravel 12 upgrade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}